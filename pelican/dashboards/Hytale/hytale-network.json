        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (server, world) (hytale_world_players{job=\"hytale\", server=~\"$server\"}) > 0",
          "legendFormat": "{{server}} / {{world}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
