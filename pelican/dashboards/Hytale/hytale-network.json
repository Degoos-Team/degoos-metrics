    {
      "type": "row",
      "title": "Performance",
      "id": 3,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tick budget used (busiest world)",
      "description": "Average tick length over the last 10 s as a share of the tick budget (1 / target TPS) in each server's busiest world. Above 100% the world falls behind its target TPS.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (server) (hytale_world_tick_seconds{job=\"hytale\", server=~\"$server\", stat=\"avg\"} * on (server, world) group_left hytale_world_tps_target{job=\"hytale\", server=~\"$server\"}) * 100",
          "legendFormat": "{{server}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 18
    },
    {
      "type": "timeseries",
      "title": "Longest tick (busiest world)",
      "description": "Longest single tick in the last 10 s. Spikes show stutters.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
